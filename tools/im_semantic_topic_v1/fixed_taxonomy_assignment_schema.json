{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassIn IM fixed variable-depth taxonomy assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "taxonomy_version", "assignments"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_instance_id",
          "outcome",
          "target_node_id",
          "confidence",
          "reasoning_brief"
        ],
        "properties": {
          "topic_instance_id": {"type": "string", "minLength": 1},
          "outcome": {
            "type": "string",
            "enum": ["assigned", "taxonomy_gap", "context_insufficient", "reject_as_topic"]
          },
          "target_node_id": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "reasoning_brief": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
